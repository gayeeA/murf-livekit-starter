# =============================================================================
# Backend environment variables — copy to .env.local and fill in real values.
# =============================================================================

# -----------------------------------------------------------------------------
# LiveKit (real-time transport)
# Get these from https://cloud.livekit.io/ → your project → Settings
# -----------------------------------------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# -----------------------------------------------------------------------------
# Murf (TTS — Text-to-Speech)
# Get your API key from https://murf.ai/api/dashboard
# -----------------------------------------------------------------------------
MURF_API_KEY=your_murf_api_key_here

# -----------------------------------------------------------------------------
# Deepgram (STT — Speech-to-Text)
# Get your API key from https://deepgram.com
# -----------------------------------------------------------------------------
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# -----------------------------------------------------------------------------
# LLM — use one of the following depending on which provider you use
# -----------------------------------------------------------------------------
# For Gemini (default): get from https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# For OpenAI: get from https://platform.openai.com/api-keys (if using OpenAI LLM)
# OPENAI_API_KEY=your_openai_api_key_here

# -----------------------------------------------------------------------------
# Outbound calling (Day 6) — LiveKit SIP outbound trunk, backed by Twilio
# (or another SIP-compatible provider, or Linphone for a free fallback).
# See backend/README.md "Day 6 — Outbound calling" for the full setup:
# buy a Twilio number, create a Twilio Elastic SIP Trunk pointing at your
# LiveKit SIP URI, then create a LiveKit outbound trunk referencing it.
# -----------------------------------------------------------------------------
# SIP_OUTBOUND_TRUNK_ID=ST_xxxxxxxxxxxx

# -----------------------------------------------------------------------------
# Human escalation (Day 7) — where "create_escalation" tickets get posted.
# Optional: tickets are always saved locally (backend/escalations.db,
# viewable with `uv run python src/view_escalations.py`) even without this
# set. Set it to also notify a real channel.
# Create one in Discord: Server Settings -> Integrations -> Webhooks -> New
# Webhook -> Copy Webhook URL.
# -----------------------------------------------------------------------------
# DISCORD_ESCALATION_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/xxxx
# -----------------------------------------------------------------------------
# Call analytics dashboard (Day 8) — every real call's outcome is logged to
# backend/calls.db and served by `uv run python src/dashboard_server.py`.
# Optional: defaults shown below.
# -----------------------------------------------------------------------------
# DASHBOARD_PORT=8787
# CALLS_DB_PATH=./calls.db